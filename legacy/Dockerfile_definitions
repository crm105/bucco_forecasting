FROM python:3.10-slim


COPY requirements.txt /opt/dagster/app/requirements.txt
COPY . /opt/dagster/app


WORKDIR /opt/dagster/app

ENV FILE_CONTENT $(cat .env)

RUN pip install -r requirements.txt

# Run dagster code server on port 4000
EXPOSE 4000

# CMD allows this to be overridden from run launchers or executors to execute runs and steps
CMD ["dagster", "code-server", "start", "-h", "0.0.0.0", "-p", "4000", "-f", "dagster_definitions.py"]
